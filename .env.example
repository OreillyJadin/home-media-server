TZ=America/Chicago
PUID=1000
PGID=1000
MEDIA_DIR=/srv/media
RECORDINGS_DIR=/srv/recordings
RENDER_GID=44
# GPU override list, set by install.sh when /dev/dri/renderD128 exists.
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# Camera RTSP password (replace before adding cameras). Keep the single quotes; they let the password contain $ and other symbols.
FRIGATE_RTSP_PASSWORD='changeme'
FRIGATE_SHM=512mb
# Add your server's Tailscale IP:3000 here (comma separated, no spaces) to open the dashboard remotely.
HOMEPAGE_ALLOWED_HOSTS=192.168.1.10:3000,localhost:3000
