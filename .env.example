TZ=America/Chicago
PUID=1000
PGID=1000
MEDIA_DIR=/srv/media
RECORDINGS_DIR=/srv/recordings
RENDER_GID=44
# GPU override list, set by install.sh when /dev/dri/renderD128 exists.
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# Camera RTSP password (replace before adding cameras).
FRIGATE_RTSP_PASSWORD=changeme
FRIGATE_SHM=512mb
